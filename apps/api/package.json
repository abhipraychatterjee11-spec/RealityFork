{
  "name": "@realityfork/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "demo:mock": "tsx scripts/demo.ts mock",
    "demo:evm": "tsx scripts/demo.ts evm",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@realityfork/shared": "workspace:*",
    "fastify": "^5.6.1",
    "viem": "2.38.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
